# Só configurações sem segredo. Os segredos nascem no exports.sh a partir do APP_SEED do Umbrel.
FLUXER_S3_ACCESS_KEY=fluxer
LIVEKIT_API_KEY=fluxer
FLUXER_REGISTRY_OWNER=fluxerapp
FLUXER_IMAGE_TAG=v1
FLUXER_PUBLIC_SCHEME=http
FLUXER_PUBLIC_PORT=3005
FLUXER_EDGE_SITE_ADDRESS=:8080
FLUXER_LIVEKIT_USE_EXTERNAL_IP=false
FLUXER_POSTGRES_MEMORY_LIMIT=1536mb
FLUXER_POSTGRES_MEMORY_RESERVATION=512mb
FLUXER_POSTGRES_SHARED_BUFFERS=128MB
FLUXER_POSTGRES_EFFECTIVE_CACHE_SIZE=512MB
FLUXER_API_MEMORY_LIMIT=1024mb
FLUXER_API_MEMORY_RESERVATION=256mb
