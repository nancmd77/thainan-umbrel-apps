  "SKIP": [
    {
      "name": "Proton Pass",
      "reason": "Proprietary cloud-only server; clients are OSS but there is no self-hostable Pass server. Do not substitute Vaultwarden unless asked."
    },
    {
      "name": "Anytype (any-sync)",
      "reason": "Self-host is a multi-node sync network (no browser UI). Clients need client.yml; too complex / wrong UX for Umbrel Open button."
    },
    {
      "name": "Readest",
      "reason": "Official Docker needs full Supabase stack (Postgres, Kong, GoTrue, PostgREST, MinIO) \u2014 too heavy/fragile for simplest Umbrel packaging."
    },
    {
      "name": "Novu",
      "reason": "Self-hostable but heavy multi-service stack (Mongo, Redis, workers, etc.); skipped for simplest packaging."
    },
    {
      "name": "Rakazo",
      "reason": "Compose requires docker.sock, local image builds, and sandbox supervisor \u2014 not suitable as a normal Umbrel community app."
    },
    {
      "name": "treg",
      "reason": "No published Docker image; Python/uv install only."
    },
    {
      "name": "Billmora",
      "reason": "Laravel hosting-billing platform; no simple published Docker image found (release/PHP install path)."
    }
  ]
