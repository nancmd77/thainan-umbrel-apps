#!/usr/bin/env python3
"""
CLI Moondream Cloud (md) para mira e auxilio visual a agentes de Computer Use.
Suporta subcomandos: point, detect e ask.
"""

import argparse
import base64
import io
import json
import os
import re
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

MOONDREAM_API_BASE = "https://api.moondream.ai/v1"


def get_api_key():
    """Busca a chave Moondream na variavel de ambiente ou arquivo montado."""
    env_key = os.environ.get("MOONDREAM_API_KEY", "").strip()
    if env_key:
        return env_key

    candidate_files = []
    app_data = os.environ.get("APP_DATA_DIR")
    if app_data:
        candidate_files.append(os.path.join(app_data, "config", "moondream.key"))

    candidate_files.extend([
        "/config/moondream.key",
        "/data/config/moondream.key",
        os.path.expanduser("~/.config/moondream/moondream.key"),
    ])

    for path in candidate_files:
        if os.path.isfile(path):
            try:
                with open(path, "r", encoding="utf-8") as f:
                    key = f.read().strip()
                    if key:
                        return key
            except Exception:
                continue

    return None


def capture_display(display=None):
    """Captura screenshot do display X11 indicado (padrao :1)."""
    target_display = display or os.environ.get("DISPLAY") or ":1"

    # 1. Tentativa via PIL ImageGrab
    try:
        from PIL import ImageGrab
        img = ImageGrab.grab(xdisplay=target_display)
        if img is not None:
            return img
    except Exception:
        pass

    # 2. Tentativa via scrot
    try:
        import tempfile
        with tempfile.NamedTemporaryFile(suffix=".png", delete=False) as tf:
            tmp_png = tf.name
        env = dict(os.environ, DISPLAY=target_display)
        res = subprocess.run(["scrot", "-z", "-d", "0", tmp_png], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if res.returncode == 0 and os.path.isfile(tmp_png) and os.path.getsize(tmp_png) > 0:
            from PIL import Image
            img = Image.open(tmp_png)
            img.load()
            try:
                os.unlink(tmp_png)
            except Exception:
                pass
            return img
        try:
            os.unlink(tmp_png)
        except Exception:
            pass
    except Exception:
        pass

    # 3. Tentativa via import (ImageMagick)
    try:
        import tempfile
        with tempfile.NamedTemporaryFile(suffix=".png", delete=False) as tf:
            tmp_png = tf.name
        env = dict(os.environ, DISPLAY=target_display)
        res = subprocess.run(["import", "-window", "root", tmp_png], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if res.returncode == 0 and os.path.isfile(tmp_png) and os.path.getsize(tmp_png) > 0:
            from PIL import Image
            img = Image.open(tmp_png)
            img.load()
            try:
                os.unlink(tmp_png)
            except Exception:
                pass
            return img
        try:
            os.unlink(tmp_png)
        except Exception:
            pass
    except Exception:
        pass

    # 4. Tentativa via xwd
    try:
        import tempfile
        import struct
        with tempfile.NamedTemporaryFile(suffix=".xwd", delete=False) as tf:
            tmp_xwd = tf.name
        env = dict(os.environ, DISPLAY=target_display)
        res = subprocess.run(["xwd", "-display", target_display, "-root", "-silent", "-out", tmp_xwd], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if res.returncode == 0 and os.path.isfile(tmp_xwd) and os.path.getsize(tmp_xwd) > 100:
            from PIL import Image
            try:
                img = Image.open(tmp_xwd)
                img.load()
                os.unlink(tmp_xwd)
                return img
            except Exception:
                with open(tmp_xwd, "rb") as f:
                    raw = f.read()
                os.unlink(tmp_xwd)
                if len(raw) > 100:
                    hdr = raw[:100]
                    hdr_vals = struct.unpack(">25I", hdr)
                    hdr_size = hdr_vals[0]
                    width = hdr_vals[4]
                    height = hdr_vals[5]
                    bpp = hdr_vals[11]
                    pixel_bytes = raw[hdr_size:]
                    if bpp == 32 and len(pixel_bytes) >= width * height * 4:
                        img = Image.frombytes("RGBA", (width, height), pixel_bytes[:width * height * 4], "raw", "BGRA")
                        return img.convert("RGB")
    except Exception:
        pass

    raise RuntimeError(f"Nao foi possivel capturar screenshot do display {target_display}")


def prepare_image_payload(image_obj_or_path, display=None):
    """Carrega ou captura imagem, reduz para <=1280px de largura e gera data URI JPEG q85."""
    from PIL import Image

    if isinstance(image_obj_or_path, str):
        img = Image.open(image_obj_or_path)
    elif image_obj_or_path is not None:
        img = image_obj_or_path
    else:
        img = capture_display(display)

    orig_w, orig_h = img.size

    # Reducao proporcional para <= 1280px de largura
    if orig_w > 1280:
        target_w = 1280
        target_h = max(1, int(round(orig_h * (1280.0 / orig_w))))
        resized_img = img.resize((target_w, target_h), Image.Resampling.LANCZOS)
    else:
        resized_img = img

    buf = io.BytesIO()
    resized_img.convert("RGB").save(buf, format="JPEG", quality=85)
    b64_data = base64.b64encode(buf.getvalue()).decode("ascii")
    data_uri = f"data:image/jpeg;base64,{b64_data}"

    return data_uri, orig_w, orig_h


def post_moondream(endpoint, payload, api_key):
    """Envia POST com autenticacao Moondream e retorna o dicionario de resposta."""
    url = f"{MOONDREAM_API_BASE}/{endpoint}"
    data_bytes = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(
        url,
        data=data_bytes,
        headers={
            "X-Moondream-Auth": api_key,
            "Content-Type": "application/json",
            "User-Agent": "thainan-openbot-md/0.61.0-r8",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            body = resp.read().decode("utf-8", errors="replace")
            return json.loads(body)
    except urllib.error.HTTPError as exc:
        err_msg = exc.read().decode("utf-8", errors="replace")
        raise RuntimeError(f"Moondream API retornou HTTP {exc.code}: {err_msg}")
    except Exception as exc:
        raise RuntimeError(f"Falha na conexao com Moondream: {exc}")


def get_current_mouse(display):
    """Obtem coordenadas atuais do cursor via xdotool."""
    try:
        env = dict(os.environ, DISPLAY=display)
        res = subprocess.run(["xdotool", "getmouselocation"], env=env, capture_output=True, text=True, check=False)
        m = re.search(r"x:(\d+)\s+y:(\d+)", res.stdout)
        if m:
            return int(m.group(1)), int(m.group(2))
    except Exception:
        pass
    return None


def glide_mouse(target_x, target_y, display, steps=12, total_ms=180):
    """Move o mouse com glide suave usando easing em ~12 passos (~180 ms total)."""
    curr = get_current_mouse(display)
    if curr is None:
        start_x, start_y = target_x, target_y
    else:
        start_x, start_y = curr

    if start_x == target_x and start_y == target_y:
        return

    env = dict(os.environ, DISPLAY=display)
    step_duration = (total_ms / 1000.0) / float(steps)

    for i in range(1, steps + 1):
        u = float(i) / float(steps)
        # Smoothstep easing: 3*u^2 - 2*u^3
        ease = 3.0 * (u ** 2) - 2.0 * (u ** 3)
        cur_x = int(round(start_x + (target_x - start_x) * ease))
        cur_y = int(round(start_y + (target_y - start_y) * ease))
        subprocess.run(["xdotool", "mousemove", "--", str(cur_x), str(cur_y)], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        time.sleep(step_duration)

    subprocess.run(["xdotool", "mousemove", "--", str(target_x), str(target_y)], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def show_hark_pulse_tk(x, y, display, duration_ms=400):
    """Exibe anel de pulso estilo Hark por 400 ms em janela X sem borda, sem roubar foco."""
    # Executa de forma assincrona via subprocesso leve
    code = f"""
import tkinter as tk
try:
    root = tk.Tk(screenName='{display}')
    root.overrideredirect(True)
    size = 48
    x0 = {x} - size // 2
    y0 = {y} - size // 2
    root.geometry(f'{{size}}x{{size}}+{{x0}}+{{y0}}')
    try:
        root.attributes('-topmost', True)
    except Exception:
        pass
    try:
        root.attributes('-alpha', 0.85)
    except Exception:
        pass
    c = tk.Canvas(root, width=size, height=size, highlightthickness=0, bg='#000000')
    try:
        root.wm_attributes('-transparentcolor', '#000000')
    except Exception:
        pass
    c.pack(fill='both', expand=True)
    c.create_oval(3, 3, size-3, size-3, outline='#00e5ff', width=3)
    c.create_oval(14, 14, size-14, size-14, outline='#00e5ff', width=1)
    root.after({duration_ms}, root.destroy)
    root.mainloop()
except Exception:
    pass
"""
    try:
        env = dict(os.environ, DISPLAY=display)
        subprocess.Popen([sys.executable, "-c", code], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass


def execute_click(x, y, display, click_type, sem_cursor=False):
    """Move cursor e dispara clique com estilizacao Hark opcional."""
    env = dict(os.environ, DISPLAY=display)

    if not sem_cursor:
        glide_mouse(x, y, display, steps=12, total_ms=180)
        show_hark_pulse_tk(x, y, display, duration_ms=400)
    else:
        subprocess.run(["xdotool", "mousemove", "--", str(x), str(y)], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    if click_type == "click":
        subprocess.run(["xdotool", "click", "1"], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    elif click_type == "double":
        subprocess.run(["xdotool", "click", "--repeat", "2", "--delay", "50", "1"], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    elif click_type == "right":
        subprocess.run(["xdotool", "click", "3"], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def cmd_point(args):
    api_key = get_api_key()
    if not api_key:
        sys.stderr.write("erro: chave ausente\n")
        sys.exit(1)

    display = args.display or os.environ.get("DISPLAY") or ":1"
    data_uri, orig_w, orig_h = prepare_image_payload(args.image, display=display)

    payload = {
        "image_url": data_uri,
        "object": args.target,
    }

    resp = post_moondream("point", payload, api_key)
    points = resp.get("points", [])
    if not points:
        sys.stderr.write(f"nenhum alvo encontrado para '{args.target}'\n")
        sys.exit(2)

    primary = points[0]
    norm_x = float(primary.get("x", 0.0))
    norm_y = float(primary.get("y", 0.0))
    real_x = int(round(norm_x * orig_w))
    real_y = int(round(norm_y * orig_h))

    result = {
        "target": args.target,
        "pixel": {"x": real_x, "y": real_y},
        "normalized": {"x": norm_x, "y": norm_y},
        "screen_size": {"width": orig_w, "height": orig_h},
        "all_points": [
            {
                "pixel": {"x": int(round(p["x"] * orig_w)), "y": int(round(p["y"] * orig_h))},
                "normalized": {"x": p["x"], "y": p["y"]},
            }
            for p in points
        ],
    }

    print(json.dumps(result, ensure_ascii=False))

    click_type = None
    if args.click:
        click_type = "click"
    elif args.double:
        click_type = "double"
    elif args.right:
        click_type = "right"

    if click_type:
        execute_click(real_x, real_y, display, click_type, sem_cursor=args.sem_cursor)


def cmd_detect(args):
    api_key = get_api_key()
    if not api_key:
        sys.stderr.write("erro: chave ausente\n")
        sys.exit(1)

    display = args.display or os.environ.get("DISPLAY") or ":1"
    data_uri, orig_w, orig_h = prepare_image_payload(args.image, display=display)

    payload = {
        "image_url": data_uri,
        "object": args.target,
    }

    resp = post_moondream("detect", payload, api_key)
    objects = resp.get("objects", [])

    converted = []
    for obj in objects:
        x_min = float(obj.get("x_min", 0.0))
        y_min = float(obj.get("y_min", 0.0))
        x_max = float(obj.get("x_max", 0.0))
        y_max = float(obj.get("y_max", 0.0))
        converted.append({
            "pixel": {
                "x_min": int(round(x_min * orig_w)),
                "y_min": int(round(y_min * orig_h)),
                "x_max": int(round(x_max * orig_w)),
                "y_max": int(round(y_max * orig_h)),
            },
            "normalized": {
                "x_min": x_min,
                "y_min": y_min,
                "x_max": x_max,
                "y_max": y_max,
            },
        })

    result = {
        "target": args.target,
        "count": len(converted),
        "screen_size": {"width": orig_w, "height": orig_h},
        "objects": converted,
    }

    print(json.dumps(result, ensure_ascii=False))


def cmd_ask(args):
    api_key = get_api_key()
    if not api_key:
        sys.stderr.write("erro: chave ausente\n")
        sys.exit(1)

    display = args.display or os.environ.get("DISPLAY") or ":1"
    data_uri, orig_w, orig_h = prepare_image_payload(args.image, display=display)

    payload = {
        "image_url": data_uri,
        "question": args.question,
    }

    resp = post_moondream("query", payload, api_key)
    answer = resp.get("answer") or resp.get("caption") or ""

    result = {
        "question": args.question,
        "answer": answer,
        "screen_size": {"width": orig_w, "height": orig_h},
    }

    print(json.dumps(result, ensure_ascii=False))


def main():
    parser = argparse.ArgumentParser(
        prog="md",
        description="Ferramenta CLI do Moondream Cloud para mira visual e computer use no OpenBot",
    )
    subparsers = parser.add_subparsers(dest="subcommand", help="Subcomandos disponiveis")

    # Subcomando point
    p_point = subparsers.add_parser("point", help="Localiza as coordenadas centrais de um alvo visual no display")
    p_point.add_argument("target", help="Descricao textual do elemento visual alvo (ex: 'Send button')")
    p_point.add_argument("--display", default=None, help="Display X11 (padrao: :1 ou variavel DISPLAY)")
    p_point.add_argument("--image", default=None, help="Arquivo de imagem opcional (para testes sem captura de display)")
    p_point.add_argument("--sem-cursor", action="store_true", help="Desativa o glide suave e o pulso de anel Hark")
    click_group = p_point.add_mutually_exclusive_group()
    click_group.add_argument("--click", action="store_true", help="Executa clique simples com botao esquerdo")
    click_group.add_argument("--double", action="store_true", help="Executa clique duplo com botao esquerdo")
    click_group.add_argument("--right", action="store_true", help="Executa clique com botao direito")
    p_point.set_defaults(func=cmd_point)

    # Subcomando detect
    p_detect = subparsers.add_parser("detect", help="Detecta caixas delimitadoras (bounding boxes) do elemento alvo")
    p_detect.add_argument("target", help="Descricao textual do objeto alvo")
    p_detect.add_argument("--display", default=None, help="Display X11 (padrao: :1 ou variavel DISPLAY)")
    p_detect.add_argument("--image", default=None, help="Arquivo de imagem opcional")
    p_detect.set_defaults(func=cmd_detect)

    # Subcomando ask
    p_ask = subparsers.add_parser("ask", help="Faz uma pergunta sobre a imagem da tela usando Moondream VQA")
    p_ask.add_argument("question", help="Pergunta sobre a tela (ex: 'Qual botao esta selecionado?')")
    p_ask.add_argument("--display", default=None, help="Display X11 (padrao: :1 ou variavel DISPLAY)")
    p_ask.add_argument("--image", default=None, help="Arquivo de imagem opcional")
    p_ask.set_defaults(func=cmd_ask)

    args = parser.parse_args()
    if not args.subcommand:
        parser.print_help()
        sys.exit(0)

    try:
        args.func(args)
    except Exception as exc:
        sys.stderr.write(f"erro: {exc}\n")
        sys.exit(1)


if __name__ == "__main__":
    main()
